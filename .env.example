# ==============================================================================
# OmniForge - Environment Configuration Template
# Copy to .env and configure values for your deployment environment.
# ==============================================================================

# Environment & Runtime
OMNIFORGE_ENVIRONMENT=development
OMNIFORGE_DEBUG=false
OMNIFORGE_RANDOM_SEED=42
OMNIFORGE_WORKSPACE_DIR=./.omniforge_workspace
OMNIFORGE_PATHS__WORKSPACE_DIR=./.omniforge_workspace
OMNIFORGE_PATHS__ARTIFACT_STORE_DIR=./.omniforge_workspace/artifacts
OMNIFORGE_PATHS__TRACKING_DB_PATH=./.omniforge_workspace/mlops_tracking.db
OMNIFORGE_PATHS__REGISTRY_DB_PATH=./.omniforge_workspace/model_registry.db
OMNIFORGE_PATHS__AUDIT_LOG_PATH=./.omniforge_workspace/audit.jsonl

# Logging
OMNIFORGE_LOGGING__LEVEL=INFO
OMNIFORGE_LOGGING__FORMAT=json
OMNIFORGE_LOGGING__REDACT_SECRETS=true

# Security & Compliance
# REQUIRED in production (OMNIFORGE_ENVIRONMENT=production) — generate high-entropy
# >=32-byte secrets (e.g., `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# In local development, blank values are auto-generated and persisted with 0600 permissions
# under .omniforge_workspace/.secrets/.
OMNIFORGE_SECURITY__JWT_SECRET_KEY=
OMNIFORGE_SECURITY__JWT_ALGORITHM=HS256
OMNIFORGE_SECURITY__JWT_EXPIRATION_MINUTES=60
OMNIFORGE_SECURITY__ENCRYPTION_KEY=
OMNIFORGE_SECURITY__ARTIFACT_SIGNING_KEY=
OMNIFORGE_SECURITY__API_KEY=
OMNIFORGE_SECURITY__AUTO_BOOTSTRAP_LOCAL_UI=true
OMNIFORGE_SECURITY__ENABLE_RBAC=true
OMNIFORGE_SECURITY__DEFAULT_TENANT_ID=default-tenant
OMNIFORGE_SECURITY__COMPLIANCE_PROFILES=["GDPR","SOX"]

# Audit log out-of-band checkpoint anchor (RFC 9162-style, optional; default OFF).
# Point OMNIFORGE_AUDIT__ANCHOR_PATH at a separate append-only JSONL checkpoint file
# (ideally a different mount or replicated to independent storage) and provide a
# high-entropy OMNIFORGE_AUDIT__CHECKPOINT_KEY. In production the key is REQUIRED
# when anchoring is enabled; in local dev a 0600 keyfile is generated automatically.
# OMNIFORGE_AUDIT__ANCHOR_EVERY=1 anchors every event; set to 0/false/off to disable.
OMNIFORGE_AUDIT__ANCHOR_PATH=
OMNIFORGE_AUDIT__CHECKPOINT_KEY=
OMNIFORGE_AUDIT__ANCHOR_EVERY=1

# Compute & Carbon Tracking
OMNIFORGE_COMPUTE__N_JOBS=-1
OMNIFORGE_COMPUTE__PREFER_GPU=true
OMNIFORGE_CARBON__ENABLED=true
OMNIFORGE_CARBON__REGION_INTENSITY_G_PER_KWH=380.0
OMNIFORGE_CARBON__COUNTRY_ISO=DEU

# AI Copilot LLM Providers (optional - local deterministic planner works offline)
OMNIFORGE_COPILOT__PROVIDER=local
OMNIFORGE_COPILOT__MODEL=gpt-4o-mini
OMNIFORGE_COPILOT__TEMPERATURE=0.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# API, UI & Desktop Launcher Server Settings
OMNIFORGE_HOST=127.0.0.1
OMNIFORGE_API_HOST=0.0.0.0
OMNIFORGE_API_PORT=8000
OMNIFORGE_API_WORKERS=1
OMNIFORGE_UI_HOST=0.0.0.0
OMNIFORGE_UI_PORT=8501
OMNIFORGE_API__CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8000","http://127.0.0.1:8000"]
OMNIFORGE_API__CORS_ALLOW_CREDENTIALS=true
# Browser-hardening headers. CSP ships in Report-Only mode first (audit P1-11):
# collect reports, then enforce by removing "-Report-Only" in a future release.
OMNIFORGE_API__CSP_REPORT_ONLY_ENABLED=true
OMNIFORGE_API__CSP_REPORT_ONLY_POLICY="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'"
OMNIFORGE_API__HSTS_ENABLED=true
OMNIFORGE_API__HSTS_MAX_AGE=31536000
OMNIFORGE_API__HSTS_INCLUDE_SUBDOMAINS=true
# In-process sliding-window limiter (per client IP). Raise for real deployments or
# front with a shared limiter; 0 disables (test-suite).
OMNIFORGE_API__RATE_LIMIT_PER_MINUTE=300
OMNIFORGE_API__MAX_REQUEST_BODY_BYTES=268435456

# Optional External Database Connector Security Controls
# Colon/semicolon-separated extra local directories permitted for SQLite/Access connectors:
OMNIFORGE_ALLOWED_DB_DIRS=
# Comma-separated private/internal hostnames explicitly permitted for remote SQL connectors:
OMNIFORGE_ALLOWED_DB_HOSTS=
OMNIFORGE_ALLOW_PRIVATE_DB_HOSTS=false
OMNIFORGE_DATABASE_URL=
OMNIFORGE_MLFLOW_TRACKING_URI=
OMNIFORGE_FEAST_REPO_PATH=
OMNIFORGE_KAFKA_BOOTSTRAP_SERVERS=
